/* INDRA TUI — Vedic Command Surface, ported from packages/design-tokens. */

Screen {
    background: #07090d;
    color: #e8eef4;
}

Header {
    background: #0c1018;
    color: #4dc8c8;
}

Footer {
    background: #0c1018;
    color: #637585;
}

#conn {
    height: 1;
    padding: 0 1;
    background: #0c1018;
    border-bottom: solid #263445;
}

#switch {
    height: 1fr;
    padding: 1 1;
}

#command {
    overflow-y: auto;
}

.pane-title {
    color: #637585;
    text-style: bold;
    padding: 0 1;
    margin-top: 1;
}

/* ── Command: banner + tiles ── */
#banner {
    height: auto;
    color: #4dc8c8;
    text-align: center;
    content-align: center top;
    padding-bottom: 1;
}

#tiles {
    height: auto;
}

.metric-tile {
    width: 1fr;
    height: 8;
    background: #0c1018;
    border-top: heavy #4dc8c8;
    padding: 0 1;
    margin: 0 1 0 0;
}

.tile-label {
    color: #637585;
    text-style: bold;
}

.tile-value {
    color: #e8eef4;
    height: 3;
}

.tile-unit {
    color: #637585;
}

/* ── Command: host + sparkline ── */
#cmd-mid {
    height: auto;
    margin-top: 1;
}

#host-box {
    width: 1fr;
    height: auto;
    background: #0c1018;
    border-left: thick #d4843a;
    padding: 0 1;
    margin-right: 1;
}

.host-gauge {
    height: 1;
}

#host-extra {
    color: #637585;
    margin-top: 1;
}

#spark-box {
    width: 1fr;
    height: auto;
    background: #0c1018;
    border-left: thick #4dc8c8;
    padding: 0 1;
}

#burn-spark {
    height: 6;
}

.sparkline--max-color {
    color: #4dc8c8;
}

.sparkline--min-color {
    color: #263445;
}

/* ── Command: alerts ── */
#alerts-box {
    height: auto;
    margin-top: 1;
    background: #0c1018;
    border-left: thick #c44450;
    padding: 0 1;
}

#alerts {
    height: auto;
}

/* ── Tables ── */
DataTable {
    height: 1fr;
    background: #0c1018;
}

#task-stats, #brain-stats {
    height: 1;
    padding: 0 1;
    color: #a8b8c8;
}

#tp-filter, #deva-filter {
    height: 3;
    margin: 0 1;
    border: round #334455;
    background: #0c1018;
}

#tp-empty {
    height: auto;
    padding: 2 2;
}

/* ── Drill-down + help modals ── */
DetailModal, HelpModal {
    align: center middle;
}

#detail-box {
    width: 80%;
    max-width: 110;
    height: 80%;
    background: #111722;
    border: round #334455;
    padding: 1 2;
}

#detail-body {
    height: 1fr;
    overflow-y: auto;
}

#detail-title, #help-title {
    text-style: bold;
    padding-bottom: 1;
}

#detail-hint, #help-hint {
    height: 1;
    color: #637585;
    padding-top: 1;
}

#help-box {
    width: 66;
    height: auto;
    background: #111722;
    border: round #334455;
    padding: 1 2;
}

#help-body {
    height: auto;
}

/* ── Devas: master-detail ── */
#deva-split {
    height: 1fr;
}

#deva-list {
    width: 36;
    height: 1fr;
    background: #0c1018;
    border-right: solid #263445;
}

#deva-detail-box {
    width: 1fr;
    height: 1fr;
    padding: 0 2;
    background: #07090d;
    overflow-y: auto;
}

#deva-detail {
    height: auto;
}

/* ── Login modal ── */
LoginModal {
    align: center middle;
}

#login-box {
    width: 48;
    height: auto;
    background: #111722;
    border: round #334455;
    padding: 1 2;
}

#login-title {
    color: #4dc8c8;
    text-style: bold;
    padding-bottom: 1;
}

#login-err {
    height: 1;
    padding-top: 1;
}

#login-go {
    margin-top: 1;
    width: 100%;
}
